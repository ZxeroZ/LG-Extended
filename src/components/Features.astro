---

<section id="features" class="py-24 px-6 max-w-5xl mx-auto relative z-10">
  <div class="mb-16 text-center">
    <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4 tracking-tight">¿Qué ofrece?</h2>
    <p class="text-gray-400 max-w-2xl mx-auto font-light">Mods diseñados para integrarse con el sistema de tu dispositivo LG V60.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {features.map(feature => (
      <div class="group relative flex flex-col items-start p-8 rounded-2xl bg-[#111111] border border-white/[0.08] hover:border-white/20 transition-all duration-300">
        
        <div class="mb-5 p-3 rounded-xl bg-white/[0.05] border border-white/[0.05] text-white">
          <Fragment set:html={feature.icon} />
        </div>
        
        <h3 class="text-lg font-medium text-white tracking-tight mb-1">{feature.title}</h3>
        <p class="text-[11px] font-medium tracking-wide uppercase text-gray-500 mb-4">{feature.subtitle}</p>
        
        <p class="text-sm text-gray-400 leading-relaxed">
          {feature.description}
        </p>
      </div>
    ))}
  </div>
</section>
