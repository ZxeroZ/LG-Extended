    <!-- Logo and Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <img src="/assets/icono.png" alt="LG Extended Logo" class="w-9 h-9 rounded-lg border border-white/10 object-cover group-hover:scale-105 transition-transform" />
      <span class="text-lg font-medium tracking-tight text-white group-hover:text-gray-200 transition-colors">LG Extended</span>
    </a>

    <!-- Desktop Actions -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-medium text-gray-400 hover:text-white transition-colors">
        Inicio
      </a>
      <a href="/novedades" class="text-sm font-medium text-gray-400 hover:text-white transition-colors">
