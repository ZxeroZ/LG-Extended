    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col items-center justify-center gap-1.5 w-10 h-10 p-2 rounded-lg bg-white/5 border border-white/10 text-white hover:bg-white/10 transition-colors">
      <span class="w-5 h-0.5 bg-white transition-transform duration-300"></span>
      <span class="w-5 h-0.5 bg-white transition-transform duration-300"></span>
      <span class="w-5 h-0.5 bg-white transition-transform duration-300"></span>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-[#0a0a0a]/95 backdrop-blur-2xl border-b border-white/10 shadow-2xl overflow-hidden transition-all duration-300 opacity-0 -translate-y-2">
    <div class="flex flex-col p-6 gap-6">
      <a href="/" class="text-lg font-medium text-gray-300 hover:text-white transition-colors">Inicio</a>
      <a href="/novedades" class="text-lg font-medium text-gray-300 hover:text-white transition-colors">Novedades</a>
      <a href="/guias" class="text-lg font-medium text-gray-300 hover:text-white transition-colors">Guías</a>
      <div class="w-full h-px bg-white/10"></div>
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-gray-500 uppercase tracking-wider">Idioma</span>
        <button class="lang-toggle-btn px-4 py-2 rounded-lg bg-blue-500/20 text-blue-400 font-bold transition-colors">EN</button>
      </div>
      <a href="https://github.com/ZxeroZ/LG_Extended" target="_blank" class="w-full text-center py-3 rounded-xl bg-white text-black font-medium hover:bg-gray-200 transition-colors mt-2">
        GitHub
      </a>
    </div>
  </div>
</nav>

<script>
