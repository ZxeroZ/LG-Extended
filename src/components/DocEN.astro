  <h2>Troubleshooting</h2>
  <table>
    <thead><tr><th>Problem</th><th>Solution</th></tr></thead>
    <tbody>
      <tr><td>No active hooks shown</td><td>Restart SystemUI, verify LSPosed</td></tr>
      <tr><td>Battery style not changing</td><td>Select style and restart SystemUI</td></tr>
      <tr><td>Settings icons not changing</td><td>Toggle "Replace icons" and restart</td></tr>
      <tr><td>DPI not applying</td><td>Force stop target app</td></tr>
      <tr><td>Transparent QS not working</td><td>Toggle MIUI QS and restart SystemUI</td></tr>
    </tbody>
  </table>

